# Shopify API Credentials
# Copy this file to .env and fill in your actual credentials
# The .env file is git-ignored for security

SHOPIFY_STORE_URL=byestelledegeyter.myshopify.com
SHOPIFY_CLIENT_ID=YOUR_CLIENT_ID_HERE
SHOPIFY_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE

# Admin API Access Token (required for this script)
# Get this from: Shopify Admin > Settings > Apps > Your App > API Credentials
# After installing the app, you'll get an Admin API access token
SHOPIFY_ACCESS_TOKEN=your_access_token_here

