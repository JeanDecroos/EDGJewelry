{%- comment -%}
  List Collections Section
  Displays all collections as clickable cards
{%- endcomment -%}

<section class="list-collections" data-section-type="list-collections">
  <div class="list-collections__inner">
    <header class="list-collections__header">
      <h1 class="list-collections__title">collections</h1>
    </header>

    <div class="list-collections__grid">
      {%- for collection in collections -%}
        {%- unless collection.handle == 'all' or collection.handle == 'frontpage' -%}
          {%- if collection.products_count > 0 -%}
            <a href="{{ collection.url }}" class="collection-card" data-reveal>
              {%- if collection.featured_image != blank -%}
                <div class="collection-card__media">
                  <img
                    src="{{ collection.featured_image | image_url: width: 600 }}"
                    alt="{{ collection.featured_image.alt | escape | default: collection.title }}"
                    class="collection-card__image"
                    loading="lazy"
                    width="{{ collection.featured_image.width }}"
                    height="{{ collection.featured_image.height }}"
                  >
                </div>
              {%- else -%}
                <div class="collection-card__media collection-card__media--placeholder">
                  {{ 'collection-1' | placeholder_svg_tag: 'collection-card__placeholder-svg' }}
                </div>
              {%- endif -%}
              
              <div class="collection-card__info">
                <h2 class="collection-card__title">{{ collection.title | downcase }}</h2>
                {%- if collection.description != blank -%}
                  <p class="collection-card__description">{{ collection.description | strip_html | truncate: 100 }}</p>
                {%- endif -%}
                <p class="collection-card__count">{{ collection.products_count }} {% if collection.products_count == 1 %}product{% else %}products{% endif %}</p>
              </div>
            </a>
          {%- endif -%}
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "List Collections",
  "class": "section-list-collections",
  "settings": []
}
{% endschema %}

