{%- comment -%}
  Footer Section
  Simple inline links, same typography as site
{%- endcomment -%}

<footer class="footer" id="footer">
  <div class="footer__inner">
    <nav class="footer__nav" aria-label="Footer navigation">
      <ul class="footer__links">
        {%- if shop.policies.refund_policy != blank -%}
          <li class="footer__link-item">
            <a href="{{ shop.policies.refund_policy.url }}" class="footer__link">refund policy</a>
          </li>
        {%- endif -%}
        {%- if shop.policies.privacy_policy != blank -%}
          <li class="footer__link-item">
            <a href="{{ shop.policies.privacy_policy.url }}" class="footer__link">privacy policy</a>
          </li>
        {%- endif -%}
        {%- if shop.policies.terms_of_service != blank -%}
          <li class="footer__link-item">
            <a href="{{ shop.policies.terms_of_service.url }}" class="footer__link">terms of service</a>
          </li>
        {%- endif -%}
        {%- if shop.policies.shipping_policy != blank -%}
          <li class="footer__link-item">
            <a href="{{ shop.policies.shipping_policy.url }}" class="footer__link">shipping policy</a>
          </li>
        {%- endif -%}
        {%- if section.settings.legal_notice_url != blank -%}
          <li class="footer__link-item">
            <a href="{{ section.settings.legal_notice_url }}" class="footer__link">legal notice</a>
          </li>
        {%- endif -%}
        {%- if section.settings.contact_url != blank -%}
          <li class="footer__link-item">
            <a href="{{ section.settings.contact_url }}" class="footer__link">contact</a>
          </li>
        {%- endif -%}
        {%- if section.settings.instagram_url != blank -%}
          <li class="footer__link-item">
            <a href="{{ section.settings.instagram_url }}" class="footer__link" target="_blank" rel="noopener noreferrer">instagram</a>
          </li>
        {%- endif -%}
      </ul>
    </nav>

    <div class="footer__bottom">
      <p class="footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | downcase }}
      </p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "url",
      "id": "legal_notice_url",
      "label": "Legal notice URL"
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Contact page URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    }
  ]
}
{% endschema %}

