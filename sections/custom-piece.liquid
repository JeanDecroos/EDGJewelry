                        <li>
                          <button type="button" class="custom-piece__phone-code-option" role="option" data-phone-code-option data-country="DK" data-code="+45" data-label="Denmark +45">
                            <span class="custom-piece__phone-flag custom-piece__phone-flag--dk" aria-hidden="true"></span>
                            <span class="custom-piece__phone-code-option-name">Denmark</span>
                            <span class="custom-piece__phone-code-option-code">+45</span>
                          </button>
