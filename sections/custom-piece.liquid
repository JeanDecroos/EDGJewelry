                          <button type="button" class="custom-piece__phone-code-option" role="option" data-phone-code-option data-country="AU" data-code="+61" data-label="Australia +61">
                            <span class="custom-piece__phone-flag custom-piece__phone-flag--au" aria-hidden="true"></span>
                            <span class="custom-piece__phone-code-option-name">Australia</span>
                            <span class="custom-piece__phone-code-option-code">+61</span>
                          </button>
                        </li>
                        <li>
                          <button type="button" class="custom-piece__phone-code-option" role="option" data-phone-code-option data-country="NZ" data-code="+64" data-label="New Zealand +64">
                            <span class="custom-piece__phone-flag custom-piece__phone-flag--nz" aria-hidden="true"></span>
                            <span class="custom-piece__phone-code-option-name">New Zealand</span>
                            <span class="custom-piece__phone-code-option-code">+64</span>
                          </button>
                        </li>
