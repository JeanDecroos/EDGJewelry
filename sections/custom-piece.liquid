                          <button type="button" class="custom-piece__phone-code-option" role="option" data-phone-code-option data-country="CA" data-code="+1" data-label="Canada +1">
                            <span class="custom-piece__phone-flag custom-piece__phone-flag--ca" aria-hidden="true"></span>
                            <span class="custom-piece__phone-code-option-name">Canada</span>
                            <span class="custom-piece__phone-code-option-code">+1</span>
                          </button>
