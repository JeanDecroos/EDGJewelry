                          <button type="button" class="custom-piece__phone-code-option" role="option" data-phone-code-option data-country="AE" data-code="+971" data-label="United Arab Emirates +971">
                            <span class="custom-piece__phone-flag custom-piece__phone-flag--ae" aria-hidden="true"></span>
                            <span class="custom-piece__phone-code-option-name">United Arab Emirates</span>
                            <span class="custom-piece__phone-code-option-code">+971</span>
                          </button>
                        </li>
                      </ul>
                      <p class="custom-piece__phone-code-no-results" data-phone-code-no-results hidden>No results</p>
                    </div>
                  </div>

                  <input
                    type="tel"
                    id="ContactFormPhoneNational"
                    class="custom-piece__input custom-piece__input--phone"
                    inputmode="tel"
                    autocomplete="tel-national"
                    placeholder="{% if default_country == 'BE' %}470 12 34 56{% elsif default_country == 'NL' %}6 12345678{% else %}Phone number{% endif %}"
                    pattern="^[0-9\\s().-]{6,20}$"
                    title="Please enter your phone number"
                    data-phone-national
                    value=""
                  >
                </div>

                <input
                  type="hidden"
                  id="ContactFormPhone"
                  name="contact[phone]"
                  data-phone-e164
                  value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                >
              </div>
            </div>

            <div class="custom-piece__field">
              <label for="ContactFormType" class="custom-piece__label">{{ section.settings.type_label | default: 'Type of piece' }}</label>
              <select id="ContactFormType" name="contact[type]" class="custom-piece__select">
                <option value="">{{ section.settings.type_placeholder | default: 'Select type' }}</option>
                <option value="ring">Ring</option>
                <option value="necklace">Necklace</option>
                <option value="earrings">Earrings</option>
                <option value="bracelet">Bracelet</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div class="custom-piece__field">
              <label for="ContactFormBudget" class="custom-piece__label">{{ section.settings.budget_label | default: 'Budget range' }}</label>
              <select id="ContactFormBudget" name="contact[budget]" class="custom-piece__select">
                <option value="">{{ section.settings.budget_placeholder | default: 'Select budget range' }}</option>
                <option value="under-500">Under €500</option>
                <option value="500-1000">€500 - €1.000</option>
                <option value="1000-2500">€1.000 - €2.500</option>
                <option value="2500-5000">€2.500 - €5.000</option>
                <option value="over-5000">Over €5.000</option>
              </select>
            </div>

            <div class="custom-piece__field custom-piece__field--full">
              <label for="ContactFormMessage" class="custom-piece__label">{{ 'contact.form.message' | t }}</label>
              <textarea
                id="ContactFormMessage"
                name="contact[body]"
                class="custom-piece__textarea"
                rows="8"
                required
                placeholder="{{ section.settings.message_placeholder | default: 'Tell us about your custom piece idea...' }}"
              >{% if form.body %}{{ form.body }}{% endif %}</textarea>
            </div>

            <div class="custom-piece__field custom-piece__field--full">
              <label for="ContactFormAttachment" class="custom-piece__label">{{ section.settings.attachment_label | default: 'Attach ideas or inspiration (optional)' }}</label>
              <input
                type="file"
                id="ContactFormAttachment"
                name="contact[attachment]"
                class="custom-piece__file-input"
                accept="image/*,.pdf,.doc,.docx"
                multiple
              >
              <div class="custom-piece__file-preview" id="FilePreview"></div>
              <p class="custom-piece__file-hint">{{ section.settings.attachment_hint | default: 'You can upload images, PDFs, or documents (max 10MB per file)' }}</p>
            </div>
          </div>

          <button type="submit" class="custom-piece__submit">
            {{ section.settings.submit_label | default: 'submit inquiry' }}
          </button>
        {%- endform -%}
      </div>
    </div>
