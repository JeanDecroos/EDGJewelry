                        <li>
                          <button type="button" class="custom-piece__phone-code-option" role="option" data-phone-code-option data-country="AT" data-code="+43" data-label="Austria +43">
                            <span class="custom-piece__phone-flag custom-piece__phone-flag--at" aria-hidden="true"></span>
                            <span class="custom-piece__phone-code-option-name">Austria</span>
                            <span class="custom-piece__phone-code-option-code">+43</span>
