                        <li>
                          <button type="button" class="custom-piece__phone-code-option" role="option" data-phone-code-option data-country="SE" data-code="+46" data-label="Sweden +46">
                            <span class="custom-piece__phone-flag custom-piece__phone-flag--se" aria-hidden="true"></span>
                            <span class="custom-piece__phone-code-option-name">Sweden</span>
                            <span class="custom-piece__phone-code-option-code">+46</span>
