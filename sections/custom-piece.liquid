                        <li>
                          <button type="button" class="custom-piece__phone-code-option" role="option" data-phone-code-option data-country="GR" data-code="+30" data-label="Greece +30">
                            <span class="custom-piece__phone-flag custom-piece__phone-flag--gr" aria-hidden="true"></span>
                            <span class="custom-piece__phone-code-option-name">Greece</span>
                            <span class="custom-piece__phone-code-option-code">+30</span>
                          </button>
                        </li>
                        <li>
                          <button type="button" class="custom-piece__phone-code-option" role="option" data-phone-code-option data-country="US" data-code="+1" data-label="United States +1">
                            <span class="custom-piece__phone-flag custom-piece__phone-flag--us" aria-hidden="true"></span>
                            <span class="custom-piece__phone-code-option-name">United States</span>
