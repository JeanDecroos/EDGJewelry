                        <li>
                          <button type="button" class="custom-piece__phone-code-option" role="option" data-phone-code-option data-country="NO" data-code="+47" data-label="Norway +47">
                            <span class="custom-piece__phone-flag custom-piece__phone-flag--no" aria-hidden="true"></span>
                            <span class="custom-piece__phone-code-option-name">Norway</span>
                            <span class="custom-piece__phone-code-option-code">+47</span>
                          </button>
                        </li>
                        <li>
                          <button type="button" class="custom-piece__phone-code-option" role="option" data-phone-code-option data-country="FI" data-code="+358" data-label="Finland +358">
                            <span class="custom-piece__phone-flag custom-piece__phone-flag--fi" aria-hidden="true"></span>
                            <span class="custom-piece__phone-code-option-name">Finland</span>
                            <span class="custom-piece__phone-code-option-code">+358</span>
                          </button>
                        </li>
                        <li>
                          <button type="button" class="custom-piece__phone-code-option" role="option" data-phone-code-option data-country="PL" data-code="+48" data-label="Poland +48">
                            <span class="custom-piece__phone-flag custom-piece__phone-flag--pl" aria-hidden="true"></span>
                            <span class="custom-piece__phone-code-option-name">Poland</span>
                            <span class="custom-piece__phone-code-option-code">+48</span>
                          </button>
                        </li>
                        <li>
                          <button type="button" class="custom-piece__phone-code-option" role="option" data-phone-code-option data-country="CZ" data-code="+420" data-label="Czechia +420">
                            <span class="custom-piece__phone-flag custom-piece__phone-flag--cz" aria-hidden="true"></span>
                            <span class="custom-piece__phone-code-option-name">Czechia</span>
                            <span class="custom-piece__phone-code-option-code">+420</span>
                          </button>
                        </li>
                        <li>
                          <button type="button" class="custom-piece__phone-code-option" role="option" data-phone-code-option data-country="SK" data-code="+421" data-label="Slovakia +421">
                            <span class="custom-piece__phone-flag custom-piece__phone-flag--sk" aria-hidden="true"></span>
                            <span class="custom-piece__phone-code-option-name">Slovakia</span>
                            <span class="custom-piece__phone-code-option-code">+421</span>
                          </button>
                        </li>
                        <li>
                          <button type="button" class="custom-piece__phone-code-option" role="option" data-phone-code-option data-country="HU" data-code="+36" data-label="Hungary +36">
                            <span class="custom-piece__phone-flag custom-piece__phone-flag--hu" aria-hidden="true"></span>
                            <span class="custom-piece__phone-code-option-name">Hungary</span>
                            <span class="custom-piece__phone-code-option-code">+36</span>
                          </button>
