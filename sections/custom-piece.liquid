{%- comment -%}
  Custom Piece Section
  Page for custom jewelry orders and inquiries
{%- endcomment -%}

<section class="custom-piece" data-section-type="custom-piece">
  <div class="custom-piece__inner">
    <header class="custom-piece__header">
      <h1 class="custom-piece__title">{{ page.title | default: 'custom piece' | downcase }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="custom-piece__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </header>

    <div class="custom-piece__content">
      {%- if page.content != blank -%}
        <div class="custom-piece__description">
          {{ page.content }}
        </div>
      {%- endif -%}

      <div class="custom-piece__form-wrapper">
        {%- form 'contact', id: 'CustomPieceForm', class: 'custom-piece__form', enctype: 'multipart/form-data' -%}
          {%- if form.posted_successfully? -%}
            <div class="custom-piece__success">
              <p>{{ 'contact.form.post_success' | t }}</p>
            </div>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="custom-piece__errors">
              <ul>
                {%- for field in form.errors -%}
                  <li>
                    {%- if field == 'form' -%}
                      {{ form.errors[field] }}
                    {%- else -%}
                      <a href="#{{ field }}">{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="custom-piece__fields">
            <div class="custom-piece__field">
              <label for="ContactFormName" class="custom-piece__label">{{ 'contact.form.name' | t }}</label>
              <input
                type="text"
                id="ContactFormName"
                name="contact[name]"
                class="custom-piece__input"
                required
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              >
            </div>

            <div class="custom-piece__field">
              <label for="ContactFormEmail" class="custom-piece__label">{{ 'contact.form.email' | t }}</label>
              <input
                type="email"
                id="ContactFormEmail"
                name="contact[email]"
                class="custom-piece__input"
                required
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              >
            </div>

            <div class="custom-piece__field">
              <label for="ContactFormPhone" class="custom-piece__label">{{ 'contact.form.phone' | t }}</label>
              <div class="custom-piece__phone" data-phone-group>
                <div class="custom-piece__phone-row">
                  <select
                    id="ContactFormPhoneCountry"
                    class="custom-piece__select custom-piece__select--phone-code custom-piece__select--visually-hidden"
                    aria-label="Country code"
                    data-phone-country
                  >
                    {%- assign default_country = localization.country.iso_code | upcase -%}
                    <option value="BE:+32" data-country="BE" data-code="+32" {% if default_country == 'BE' %}selected{% endif %}>Belgium (+32)</option>
                    <option value="NL:+31" data-country="NL" data-code="+31" {% if default_country == 'NL' %}selected{% endif %}>Netherlands (+31)</option>
                    <option value="FR:+33" data-country="FR" data-code="+33" {% if default_country == 'FR' %}selected{% endif %}>France (+33)</option>
                    <option value="DE:+49" data-country="DE" data-code="+49" {% if default_country == 'DE' %}selected{% endif %}>Germany (+49)</option>
                    <option value="GB:+44" data-country="GB" data-code="+44" {% if default_country == 'GB' %}selected{% endif %}>United Kingdom (+44)</option>
                    <option value="IE:+353" data-country="IE" data-code="+353" {% if default_country == 'IE' %}selected{% endif %}>Ireland (+353)</option>
                    <option value="ES:+34" data-country="ES" data-code="+34" {% if default_country == 'ES' %}selected{% endif %}>Spain (+34)</option>
                    <option value="IT:+39" data-country="IT" data-code="+39" {% if default_country == 'IT' %}selected{% endif %}>Italy (+39)</option>
                    <option value="PT:+351" data-country="PT" data-code="+351" {% if default_country == 'PT' %}selected{% endif %}>Portugal (+351)</option>
                    <option value="LU:+352" data-country="LU" data-code="+352" {% if default_country == 'LU' %}selected{% endif %}>Luxembourg (+352)</option>
                    <option value="CH:+41" data-country="CH" data-code="+41" {% if default_country == 'CH' %}selected{% endif %}>Switzerland (+41)</option>
                    <option value="AT:+43" data-country="AT" data-code="+43" {% if default_country == 'AT' %}selected{% endif %}>Austria (+43)</option>
                    <option value="DK:+45" data-country="DK" data-code="+45" {% if default_country == 'DK' %}selected{% endif %}>Denmark (+45)</option>
                    <option value="SE:+46" data-country="SE" data-code="+46" {% if default_country == 'SE' %}selected{% endif %}>Sweden (+46)</option>
                    <option value="NO:+47" data-country="NO" data-code="+47" {% if default_country == 'NO' %}selected{% endif %}>Norway (+47)</option>
                    <option value="FI:+358" data-country="FI" data-code="+358" {% if default_country == 'FI' %}selected{% endif %}>Finland (+358)</option>
                    <option value="PL:+48" data-country="PL" data-code="+48" {% if default_country == 'PL' %}selected{% endif %}>Poland (+48)</option>
                    <option value="CZ:+420" data-country="CZ" data-code="+420" {% if default_country == 'CZ' %}selected{% endif %}>Czechia (+420)</option>
                    <option value="SK:+421" data-country="SK" data-code="+421" {% if default_country == 'SK' %}selected{% endif %}>Slovakia (+421)</option>
                    <option value="HU:+36" data-country="HU" data-code="+36" {% if default_country == 'HU' %}selected{% endif %}>Hungary (+36)</option>
                    <option value="RO:+40" data-country="RO" data-code="+40" {% if default_country == 'RO' %}selected{% endif %}>Romania (+40)</option>
                    <option value="BG:+359" data-country="BG" data-code="+359" {% if default_country == 'BG' %}selected{% endif %}>Bulgaria (+359)</option>
                    <option value="GR:+30" data-country="GR" data-code="+30" {% if default_country == 'GR' %}selected{% endif %}>Greece (+30)</option>
                    <option value="US:+1" data-country="US" data-code="+1" {% if default_country == 'US' %}selected{% endif %}>United States (+1)</option>
                    <option value="CA:+1" data-country="CA" data-code="+1" {% if default_country == 'CA' %}selected{% endif %}>Canada (+1)</option>
                    <option value="AU:+61" data-country="AU" data-code="+61" {% if default_country == 'AU' %}selected{% endif %}>Australia (+61)</option>
                    <option value="NZ:+64" data-country="NZ" data-code="+64" {% if default_country == 'NZ' %}selected{% endif %}>New Zealand (+64)</option>
                    <option value="AE:+971" data-country="AE" data-code="+971" {% if default_country == 'AE' %}selected{% endif %}>United Arab Emirates (+971)</option>
                  </select>

