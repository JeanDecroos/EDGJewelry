{%- comment -%}
  Featured Collection Section
  Grid of products from a selected collection
{%- endcomment -%}

{%- liquid
  assign collection = collections[section.settings.collection]
  assign products_to_show = section.settings.products_to_show | default: 8
-%}

<section class="featured-collection" data-section-type="featured-collection">
  <div class="featured-collection__inner">
    {%- if section.settings.heading != blank -%}
      <header class="featured-collection__header">
        <h2 class="featured-collection__heading">{{ section.settings.heading | downcase }}</h2>
        {%- if section.settings.show_view_all and collection != blank -%}
          <a href="{{ collection.url }}" class="featured-collection__view-all">view all</a>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="product-grid product-grid--{{ section.settings.columns_desktop }}">
      {%- if collection != blank -%}
        {%- for product in collection.products limit: products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..products_to_show) -%}
          <div class="product-card product-card--placeholder" data-reveal>
            <div class="product-card__media">
              {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder-svg' }}
            </div>
            <div class="product-card__info">
              <h3 class="product-card__title">example product</h3>
              <p class="product-card__price">{{ shop.currency | prepend: '0.00 ' }}</p>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "featured"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 8,
      "label": "Products to show"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' link",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}

