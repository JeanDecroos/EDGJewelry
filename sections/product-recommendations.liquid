{%- comment -%}
  Product Recommendations Section
  Shows related products
{%- endcomment -%}

<section class="product-recommendations" data-section-type="product-recommendations" data-product-id="{{ product.id }}" data-limit="{{ section.settings.products_to_show }}">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="product-recommendations__inner">
      <h2 class="product-recommendations__heading">{{ section.settings.heading | default: 'you may also like' | downcase }}</h2>
      
      <div class="product-grid product-grid--{{ section.settings.columns_desktop }}">
        {%- for product in recommendations.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product Recommendations",
  "class": "section-product-recommendations",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "you may also like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    }
  ]
}
{% endschema %}

